{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayStorage",
  "version": "1.0.0",
  "identifier": "com.sorokin.playstorage",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/PlayStorage/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sorokin Ivan",
    "copyright": "Copyright (c) Sorokin Ivan",
    "category": "Game",
    "shortDescription": "PlayStorage — game launcher",
    "longDescription": "PlayStorage by sorokin: a console-style full-screen game launcher for Windows. Author: Sorokin Ivan.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
